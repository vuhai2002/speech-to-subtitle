# Configuration for transcribe/batch_transcribe_vertex.py (step 1).
# How to obtain each value: docs/vertex-ai-setup-guide.md

# Gemini model used for transcription. Remove this line entirely to fall back to gemini-2.5-flash.
GEMINI_MODEL=gemini-2.5-pro

# === VERTEX AI CONFIG ===
GOOGLE_CLOUD_PROJECT=
# e.g. us-central1
GOOGLE_CLOUD_LOCATION=
GCS_BUCKET_NAME=
# Path to the service account JSON key file, e.g. ./service-account-key.json
GOOGLE_APPLICATION_CREDENTIALS=

# === CHUNKED TRANSCRIBE (transcribe/chunked_transcribe, 9router path - experimental) ===
# OpenAI-compatible router endpoint, e.g. https://<router-host>/v1 (a self-hosted router instance, such as 9router)
ROUTER_BASE_URL=
# Router API key
ROUTER_API_KEY=
# Transcription model; leave empty to use ag/gemini-3.8-flash
TRANSCRIBE_MODEL=
# Number of chunks sent in parallel. Antigravity Pro handles 3-5, free tier 2-3. Leave empty to use 3.
ROUTER_WORKERS=

# === MAI TRANSCRIBE (transcribe/mai_transcribe, MAI-Transcribe-2 via OpenRouter - experimental) ===
# OpenRouter API key (format sk-or-v1-...). The transcription endpoint bills per second of audio (~$0.10/hour).
OPENROUTER_API_KEY=
# Model; leave empty to use microsoft/mai-transcribe-2
MAI_MODEL=
# Language hint; leave empty to use vi
MAI_LANGUAGE=
# Number of chunks sent in parallel; leave empty to use 3
MAI_WORKERS=
